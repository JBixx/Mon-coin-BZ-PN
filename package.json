{
  "name": "mon-coin-bz-pn",
  "version": "0.1.0",
  "description": "API open source qui regroupe les meilleurs coins de Brazzaville et Pointe-Noire (Congo).",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node scripts/build-check.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.js\"",
    "check": "npm run lint && npm run format:check && npm run test:coverage && npm run build"
  },
  "keywords": [
    "api",
    "express",
    "brazzaville",
    "pointe-noire",
    "congo",
    "tourisme",
    "open-source"
  ],
  "author": "JBixx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JBixx/Mon-coin-BZ-PN.git"
  },
  "bugs": {
    "url": "https://github.com/JBixx/Mon-coin-BZ-PN/issues"
  },
  "homepage": "https://github.com/JBixx/Mon-coin-BZ-PN#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "files": [
    "src"
  ]
}
